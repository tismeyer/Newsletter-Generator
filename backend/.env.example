# Which generator to use when the request does not name one
DEFAULT_PROVIDER=claude

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Azure OpenAI / Microsoft Foundry (GPT in helvetic's Azure) - from IT
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Microsoft 365 Copilot (Graph) - leave blank until the app registration exists
COPILOT_TENANT_ID=
COPILOT_CLIENT_ID=
COPILOT_CLIENT_SECRET=

CORS_ORIGINS=http://localhost:5173
MAX_CHAPTERS=10
